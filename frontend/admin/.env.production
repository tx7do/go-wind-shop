# 环境变量配置文件
VITE_ENV=pro

# ============================================
# 🌐 网络配置
# ============================================

# 代理前缀
VITE_APP_BASE_API='/admin/v1'

# 接口地址：同源（nginx 在本域名下把 /admin/v1/ 反代到 admin 后端 10600）
VITE_APP_API_URL=''

# SSE地址：同源路径（nginx 把 /events 反代到 SSE 网关 10601）
VITE_APP_SSE_URL='/events'

# ============================================
# 🎛️ 功能开关
# ============================================
# 多租户（需与后端 app.tenant.enabled 保持一致）
VITE_APP_TENANT_ENABLED=true
