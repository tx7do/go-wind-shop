# 环境变量配置文件
VITE_ENV=dev

# ============================================
# 🌐 网络配置
# ============================================

# 应用端口（10000+，避免与兄妹项目前端冲突）
VITE_APP_PORT=10300

# 代理前缀
VITE_APP_BASE_API=/admin/v1

# 接口地址（后端 admin REST 已改为 10600，避免与兄妹项目 6600 冲突）
VITE_APP_API_URL=http://localhost:10600
#VITE_APP_API_URL=https://api.admin.shop.gowind.cloud

# SSE地址
VITE_APP_SSE_URL=http://localhost:10601/events
#VITE_APP_SSE_URL=https://sse.admin.shop.gowind.cloud/events

# ============================================
# 🎛️ 功能开关
# ============================================

# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=false

# 多租户开关(true:开启 false:关闭)
VITE_APP_TENANT_ENABLED=false
