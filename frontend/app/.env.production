# 生产环境配置（nuxt generate --dotenv .env.production 时编译进产物，改后必须重新 generate）
# 注意：NUXT_PUBLIC_AES_KEY 必须与后端 authenticator.yaml 的 aes_key 保持一致，
#       静态部署无运行时注入，只能在此提供。本地开发值见 .env.development。
# 接口地址：'/' 即同源（axios baseURL，nginx 把 /app/v1/ 反代到 app 后端 10700）。
# 不能留空——nuxt.config 里 apiBaseUrl 的 || 回退会兜到 http://localhost:8000。
NUXT_PUBLIC_API_BASE_URL=/
NUXT_PUBLIC_ENABLE_MOCK=false
# AES 密钥：静态部署无运行时注入，必须在此提供（与后端 authenticator.yaml 的 aes_key
# 一致）。当前值与 admin/.env、app/.env.development 同一把开发密钥；生产后端若换了
# 密钥，改这里后必须重新 nuxt generate。
NUXT_PUBLIC_AES_KEY=f51d66a73d8a0927
# SSE 网关（AI 导购流式 chunk/tool 帧推送）：同源路径，nginx 把 /events 反代到 10701
NUXT_PUBLIC_SSE_URL=/events
